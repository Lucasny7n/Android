#!/usr/bin/env python3
"""Minimal, audited compatibility implementation for Linux 5.4 timeconst.bc.

The build host has no bc package.  Floppy's configured build invokes bc once:
``echo $CONFIG_HZ | bc -q kernel/time/timeconst.bc``.  This wrapper recognizes
only that exact input shape and reproduces the integer operations in the
checked-in timeconst.bc; it intentionally refuses to act as a general bc.
"""
from __future__ import annotations

import math
import pathlib
import sys


def fail(message: str) -> None:
    print(f"bc compatibility shim: {message}", file=sys.stderr)
    raise SystemExit(2)


arguments = [arg for arg in sys.argv[1:] if arg != "-q"]
if len(arguments) != 1 or pathlib.Path(arguments[0]).name != "timeconst.bc":
    fail("supports only 'bc -q kernel/time/timeconst.bc'")

try:
    hz = int(sys.stdin.read().strip())
except ValueError:
    fail("HZ input is not an integer")
if hz < 2:
    fail("HZ must be at least 2")


def fmul(bits: int, numerator: int, denominator: int) -> int:
    return ((1 << bits) * numerator + denominator - 1) // denominator


def fadj(bits: int, numerator: int, denominator: int) -> int:
    denominator //= math.gcd(numerator, denominator)
    return ((1 << bits) * (denominator - 1)) // denominator


def fmuls(bits: int, numerator: int, denominator: int) -> int:
    shift = 0
    while True:
        if fmul(shift, numerator, denominator) >= (1 << (bits - 1)):
            return shift
        shift += 1


def reciprocal(prefix: str, numerator: int, denominator: int) -> list[str]:
    shift = fmuls(32, numerator, denominator)
    return [
        f"#define {prefix}_MUL32\tU64_C(0x{fmul(shift, numerator, denominator):X})",
        f"#define {prefix}_ADJ32\tU64_C(0x{fadj(shift, numerator, denominator):X})",
        f"#define {prefix}_SHR32\t{shift}",
    ]


def ratio(prefix: str, numerator: int, denominator: int) -> list[str]:
    divisor = math.gcd(numerator, denominator)
    return [
        f"#define {prefix}_NUM\t\t{numerator // divisor}",
        f"#define {prefix}_DEN\t\t{denominator // divisor}",
    ]


out = [
    "/* Automatically generated by kernel/time/timeconst.bc */",
    f"/* Time conversion constants for HZ == {hz} */",
    "",
    "#ifndef KERNEL_TIMECONST_H",
    "#define KERNEL_TIMECONST_H",
    "",
    "#include <linux/param.h>",
    "#include <linux/types.h>",
    "",
    f"#if HZ != {hz}",
    '#error "include/generated/timeconst.h has the wrong HZ value!"',
    "#endif",
    "",
]
out += reciprocal("HZ_TO_MSEC", 1000, hz)
out += reciprocal("MSEC_TO_HZ", hz, 1000)
out += ratio("HZ_TO_MSEC", 1000, hz)
out += ratio("MSEC_TO_HZ", hz, 1000)
out += [""]
out += reciprocal("HZ_TO_USEC", 1000000, hz)
out += reciprocal("USEC_TO_HZ", hz, 1000000)
out += ratio("HZ_TO_USEC", 1000000, hz)
out += ratio("USEC_TO_HZ", hz, 1000000)
out += ratio("HZ_TO_NSEC", 1000000000, hz)
out += ratio("NSEC_TO_HZ", hz, 1000000000)
out += ["", "#endif /* KERNEL_TIMECONST_H */", ""]
sys.stdout.write("\n".join(out))
